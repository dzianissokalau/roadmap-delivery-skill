{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadmap-delivery.local/schemas/automation_run_log.schema.json",
  "title": "Roadmap Delivery Automation Run Log Entry",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "timestamp",
        "current_phase",
        "status",
        "progress_signature",
        "run_count",
        "stalled_run_count",
        "max_stalled_runs",
        "threshold_reached",
        "phase_6_alert_required"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "current_phase": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "last_delivered_phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_quality": {
          "$ref": "#/$defs/nullable_run_quality"
        },
        "adaptive_action": {
          "$ref": "#/$defs/nullable_adaptive_action"
        },
        "progress_signature": {
          "type": "string",
          "minLength": 1
        },
        "previous_progress_signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "progress_detected": {
          "type": "boolean"
        },
        "run_count": {
          "type": "integer",
          "minimum": 0
        },
        "stalled_run_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_stalled_runs": {
          "type": "integer",
          "minimum": 1
        },
        "threshold_reached": {
          "type": "boolean"
        },
        "phase_6_alert_required": {
          "type": "boolean"
        },
        "schema_version": {
          "not": {
            "const": 2
          }
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "run_id",
        "completed_at",
        "phase",
        "status",
        "progress"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "completed_at": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_quality": {
          "$ref": "#/$defs/nullable_run_quality"
        },
        "adaptive_action": {
          "$ref": "#/$defs/nullable_adaptive_action"
        },
        "progress": {
          "type": "string",
          "minLength": 1
        },
        "next_phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "not": {
            "const": 2
          }
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "event_type",
        "run_id",
        "timestamp",
        "phase",
        "revision_before",
        "revision_after",
        "state_changes"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "event_type": {
          "enum": [
            "run_started",
            "run_completed",
            "blocker_repaired"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "revision_before": {
          "type": "integer",
          "minimum": 0
        },
        "revision_after": {
          "type": "integer",
          "minimum": 1
        },
        "state_changes": {
          "type": "object",
          "required": [
            "progress_accounting",
            "run_count",
            "stalled_run_count",
            "active_run"
          ],
          "properties": {
            "progress_accounting": {
              "type": "object",
              "required": [
                "schema_version",
                "revision",
                "consumed_events",
                "migration"
              ],
              "properties": {
                "schema_version": {
                  "const": 1
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "consumed_events": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "migration": {
                  "type": "object"
                }
              }
            },
            "run_count": {
              "type": "integer",
              "minimum": 0
            },
            "stalled_run_count": {
              "type": "integer",
              "minimum": 0
            },
            "active_run": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        },
        "outcome": {
          "enum": [
            "completed",
            "interrupted"
          ]
        },
        "semantic_progress_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "schema_version",
              "kind",
              "phase",
              "previous",
              "current",
              "verifier",
              "event_keys"
            ],
            "properties": {
              "schema_version": {
                "const": 1
              },
              "kind": {
                "enum": [
                  "accepted_phase_work",
                  "criterion_satisfied",
                  "blocker_resolved"
                ]
              },
              "phase": {
                "type": "string",
                "minLength": 1
              },
              "previous": {
                "type": "object"
              },
              "current": {
                "type": "object"
              },
              "verifier": {
                "type": "object"
              },
              "event_keys": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "progress_detected",
            "run_count",
            "stalled_run_count",
            "threshold_reached"
          ],
          "properties": {
            "progress_detected": {
              "type": "boolean"
            },
            "run_count": {
              "type": "integer",
              "minimum": 1
            },
            "stalled_run_count": {
              "type": "integer",
              "minimum": 0
            },
            "threshold_reached": {
              "type": "boolean"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "run_completed"
              }
            }
          },
          "then": {
            "required": [
              "outcome",
              "completed_at",
              "initial_evidence",
              "semantic_progress_evidence",
              "result"
            ]
          }
        }
      ],
      "additionalProperties": true
    }
  ],
  "$defs": {
    "run_quality": {
      "type": "string",
      "enum": [
        "flawless",
        "delivered_with_fixes",
        "verification_failed",
        "review_needs_fix",
        "blocked_local_repairable",
        "blocked_human_required",
        "stalled",
        "retarget_failed",
        "completion_closeout_failed"
      ]
    },
    "nullable_run_quality": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "flawless",
        "delivered_with_fixes",
        "verification_failed",
        "review_needs_fix",
        "blocked_local_repairable",
        "blocked_human_required",
        "stalled",
        "retarget_failed",
        "completion_closeout_failed",
        null
      ]
    },
    "nullable_adaptive_action": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "run_quality": {
          "$ref": "#/$defs/run_quality"
        },
        "target": {
          "type": "object",
          "additionalProperties": true
        },
        "target_changed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
